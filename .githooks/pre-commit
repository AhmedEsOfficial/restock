#!/bin/bash
# Restock Android Pre-commit Hook
# This hook runs code quality checks before allowing commits.

set -e

echo "🔍 Running pre-commit code quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the list of staged Kotlin files
STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kts?$' || true)

if [ -z "$STAGED_KOTLIN_FILES" ]; then
    echo -e "${GREEN}✓ No Kotlin files staged, skipping checks${NC}"
    exit 0
fi

echo "Found staged Kotlin files:"
echo "$STAGED_KOTLIN_FILES"
echo ""

# Run Ktlint on staged files
echo -e "${YELLOW}→ Running Ktlint format check...${NC}"
if ./gradlew ktlintCheck --quiet; then
    echo -e "${GREEN}✓ Ktlint check passed${NC}"
else
    echo -e "${RED}✗ Ktlint check failed${NC}"
    echo ""
    echo "To auto-fix formatting issues, run:"
    echo "  ./gradlew ktlintFormat"
    echo ""
    exit 1
fi

# Run Detekt on staged files
echo -e "${YELLOW}→ Running Detekt static analysis...${NC}"
if ./gradlew detekt --quiet; then
    echo -e "${GREEN}✓ Detekt check passed${NC}"
else
    echo -e "${RED}✗ Detekt check failed${NC}"
    echo ""
    echo "Review the Detekt report at:"
    echo "  build/reports/detekt/detekt.html"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
exit 0
